{
  "atomCode": "XMirrorSca",
  "htmlTemplateVersion": "1.2",
  "execution": {
    "packagePath": "XMirrorSca-jar-with-dependencies.jar",
    "language": "java",
    "minimumVersion": "1.8",
    "demands": [],
    "target": "java -jar XMirrorSca-jar-with-dependencies.jar"
  },
  "input": {
    "server": {
      "label": "SCA服务器地址",
      "type": "vuex-input",
      "required": true
    },
    "token": {
      "label": "Token",
      "type": "vuex-input",
      "required": true
    },
    "projectId": {
      "label": "项目ID",
      "type": "vuex-input",
      "hidden": true
    },
    "projectName": {
      "label": "项目",
      "type": "vuex-input",
      "required": true
    },
    "applicationId": {
      "label": "应用ID",
      "type": "vuex-input",
      "hidden": true
    },
    "applicationName": {
      "label": "应用",
      "type": "vuex-input",
      "required": true
    }
  }
}
